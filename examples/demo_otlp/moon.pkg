import {
  "moonbitlang/async",
  "moonbitlang/async/http" @http,
  "moonbitlang/async/socket" @socket,
  "yourname/otel/async_runtime" @async_runtime,
  "yourname/otel/instrumentation/async_http_client" @client,
  "yourname/otel/instrumentation/async_http_server" @server,
  "yourname/otel/sdk" @sdk,
}

supported_targets = "+native"

pkgtype(kind: "executable")
